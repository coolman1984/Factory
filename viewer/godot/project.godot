; Real Factory viewer and film renderer (Godot 4.7). Builds the factory at runtime from a Control Center scene package
; (control/real/export-scene.mjs) and the model library (viewer/assets). See docs/19_REAL_FACTORY.md.

config_version=5

[application]

config/name="Real Factory"
config/description="True-dimension factory from AutoCAD, driven by the Factory Engine"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/vsync/vsync_mode=0

[editor]

movie_writer/mjpeg_quality=0.95
movie_writer/fps=30

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=false
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=3
environment/ssil/quality=2
environment/screen_space_reflection/roughness_quality=2
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/screen_space_roughness_limiter/enabled=true
